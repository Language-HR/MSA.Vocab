// ---- from utils/array.js ----
function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

// ---- from utils/srs.js ----
// A small, transparent spaced-repetition engine — simplified to match a
// flashcard-only app. There is no typed recall anywhere, so mastery is
// judged purely on repeated, honest flashcard self-grading across days.
//
// A "record" is the only thing this file ever creates or mutates, and it
// only ever refers to a word/verb by its numeric id — never the textbook
// data itself.

const INTERVAL_DAYS = [0, 1, 3, 7, 14, 30, 60]; // same-session, 1d, 3d, 7d, 14d, 30d, 60d
const RECENT_WINDOW = 6;

function createEmptyRecord() {
  return {
    reps: 0,
    correct: 0,
    incorrect: 0,
    streak: 0,
    intervalIdx: 0,
    due: null,
    last: null,
    recent: [],
    consecutiveFails: 0,
  };
}

function addDays(days) {
  return new Date(Date.now() + days * 86400000).toISOString();
}

function clamp(n, lo, hi) {
  return Math.max(lo, Math.min(hi, n));
}

/**
 * Apply a grade — "again" | "hard" | "know" — to a record and return a
 * new record. Never mutates the record it's given.
 *
 *   again — didn't remember it: resets the streak and interval, so it
 *           comes back around within the same session.
 *   hard  — remembered, but with effort: a small nudge, roughly repeating
 *           the same spacing rather than growing it.
 *   know  — remembered comfortably: normal progression up the ladder.
 */
function applyGrade(record, grade) {
  const base = record || createEmptyRecord();
  const rec = { ...base, recent: [...(base.recent || [])] };
  rec.reps += 1;

  const isSuccess = grade !== "again";
  if (isSuccess) rec.correct += 1; else rec.incorrect += 1;

  rec.recent.push(isSuccess);
  if (rec.recent.length > RECENT_WINDOW) rec.recent = rec.recent.slice(-RECENT_WINDOW);
  rec.consecutiveFails = isSuccess ? 0 : (base.consecutiveFails || 0) + 1;

  if (grade === "again") {
    rec.streak = 0;
    rec.intervalIdx = 0;
  } else if (grade === "hard") {
    rec.intervalIdx = clamp(rec.intervalIdx, 0, INTERVAL_DAYS.length - 1);
  } else {
    // "know"
    rec.streak += 1;
    rec.intervalIdx = clamp(rec.intervalIdx + 1, 0, INTERVAL_DAYS.length - 1);
  }

  rec.due = addDays(INTERVAL_DAYS[rec.intervalIdx]);
  rec.last = new Date().toISOString();
  return rec;
}

function isDue(record) {
  if (!record || record.reps === 0 || !record.due) return false;
  return new Date(record.due).getTime() <= Date.now();
}

function isNew(record) {
  return !record || record.reps === 0;
}

/**
 * Weakness reflects recent behaviour, not just lifetime accuracy: a card
 * that's currently being forgotten is flagged even if its overall record
 * looks fine, and an old trouble card is allowed to quietly recover once
 * recent answers are strong again.
 */
function isWeak(record) {
  if (!record || record.reps === 0) return false;
  const recent = record.recent || [];
  const consecutiveFails = record.consecutiveFails || 0;

  if (consecutiveFails >= 2) return true;
  if (recent.length >= 3) {
    const fails = recent.filter((x) => !x).length;
    if (fails / recent.length >= 0.5) return true;
  }
  if (record.correct >= 3 && consecutiveFails >= 1 && record.intervalIdx <= 1) return true;
  if (recent.length < 3 && record.reps >= 3 && record.correct / record.reps < 0.6) return true;
  return false;
}

/** Rough priority for ordering due/weak queues — a card missed repeatedly
 * should resurface sooner than one that's merely due. */
function priorityScore(record) {
  if (!record) return 0;
  const consecutiveFails = record.consecutiveFails || 0;
  const recentFails = (record.recent || []).filter((x) => !x).length;
  return consecutiveFails * 10 + recentFails * 3 + (isWeak(record) ? 5 : 0);
}

/**
 * Only three visible stages — no learner needs to understand a seven-step
 * ladder to use the app. "Learned" requires the interval to have climbed
 * past the first couple of rungs (so a handful of days of real spacing),
 * which only happens through consistent, honest "Know it" answers.
 */
function cardStatus(record) {
  if (isNew(record)) return "new";
  if (record.intervalIdx <= 3) return "learning"; // same-session through 7-day stage
  return "learned"; // 14/30/60-day stage
}

const STATUS_LABEL = { new: "New", learning: "Learning", learned: "Learned" };
const STATUS_COLOR = { new: "#8a7f99", learning: "#c9a24a", learned: "#6fb98f" };

// ---- from utils/conjugate.js ----
// Past / present / future conjugation across eight pronouns, built on top
// of the textbook's own verified past + present forms in data/verbs.js.
// Nothing here invents new Arabic — it only derives additional person-forms
// from the two forms the textbook already gives us for each verb.
//
// APPROACH (per the accuracy requirement — see below):
//   - Sound, hollow-in-the-present, assimilated, hamza-medial, and
//     multi-letter-measure (Form II–X) verbs conjugate reliably by simple,
//     well-attested prefix/suffix rules, because Arabic person-marking on
//     the imperfect is regular once the correct prefix VOWEL is preserved
//     (Form I: fatha — يَفْعَلُ; Form II–IV: damma — يُفَعِّلُ; Form V/VI/
//     VIII/X: fatha — يَتَفَعَّلُ). That vowel is read directly off the
//     textbook's own present-tense form, so it's never guessed.
//   - Hollow verbs (medial weak root) only misbehave in the PAST tense,
//     where the long medial vowel contracts before a consonant-initial
//     suffix (نامَ -> نِمْتُ, زارَ -> زُرْتُ). Their present-tense person
//     forms are fully regular and handled by the rule above.
//   - Geminate (doubled-consonant) verbs only misbehave in the PAST tense
//     before a consonant-initial suffix, where the doubled consonant
//     splits and a linking vowel appears (أَحَبَّ -> أَحْبَبْتُ). Present
//     tense is regular.
//   - Defective verbs (final weak root letter) misbehave in BOTH tenses,
//     across most persons, because the weak letter elides/changes. These
//     are the least safe to auto-generate, so every one of the eight
//     defective verbs in this dataset has its full eight-person past
//     tense, and its three irregular present-tense persons (أنتِ / أنتم /
//     هم), verified and stored directly rather than derived.
//   - The one lexical irregular in this dataset, أَكَلَ ("to eat"), has a
//     famous exception in the first-person singular present — آكُلُ, not
//     the rule-predicted أَأْكُلُ — and is stored as a single-cell override.
//   - Future tense is always سَـ + the present-tense form and needs no
//     exceptions of its own, since it's built from the already-correct
//     present forms above.
//
// Every exception below reflects standard Modern Standard Arabic taught in
// reference grammars for "hollow", "doubled", "defective", and "hamzated"
// verbs (الأفعال المعتلة والمهموزة) — not a guess.

const PRONOUNS = [
  { key: "ana", ar: "أَنَا" },
  { key: "anta", ar: "أَنْتَ" },
  { key: "anti", ar: "أَنْتِ" },
  { key: "huwa", ar: "هُوَ" },
  { key: "hiya", ar: "هِيَ" },
  { key: "nahnu", ar: "نَحْنُ" },
  { key: "antum", ar: "أَنْتُمْ" },
  { key: "hum", ar: "هُمْ" },
];

const FATHA = "\u064E", KASRA = "\u0650", DAMMA = "\u064F", SHADDA = "\u0651";
const VOWEL_MARKS = new Set([FATHA, KASRA, DAMMA]);

// Diacritic order in this dataset isn't always "shadda then vowel" — some
// entries store "vowel then shadda" for a geminated letter. Handle both:
// strip the trailing vowel mark wherever it sits relative to a shadda,
// while always preserving the shadda itself (gemination is structural,
// not part of the person-ending we're replacing).
function stripFinalVowelMark(s) {
  const chars = [...s];
  const last = chars.length - 1;
  if (chars[last] === SHADDA && VOWEL_MARKS.has(chars[last - 1])) {
    chars.splice(last - 1, 1);
    return chars.join("");
  }
  if (VOWEL_MARKS.has(chars[last])) {
    chars.splice(last, 1);
    return chars.join("");
  }
  return s;
}

// ---- Present-tense irregular overrides: أنتِ / أنتم / هم only ----
// (the other five persons are safely rule-generated for these verbs too —
// verified individually against the rule output before being left out here).
const PRESENT_OVERRIDES = {
  18: { anti: "تَنْتَهِينَ", antum: "تَنْتَهُونَ", hum: "يَنْتَهُونَ" }, // اِنْتَهَى — defective (ي)
  38: { anti: "تَقْضِينَ", antum: "تَقْضُونَ", hum: "يَقْضُونَ" }, // قَضَى — defective (ي)
  45: { anti: "تَرْتَدِينَ", antum: "تَرْتَدُونَ", hum: "يَرْتَدُونَ" }, // اِرْتَدَى — defective (ي)
  47: { anti: "تَسْتَرْخِينَ", antum: "تَسْتَرْخُونَ", hum: "يَسْتَرْخُونَ" }, // اِسْتَرْخَى — defective (ي)
  51: { anti: "تَلْتَقِينَ", antum: "تَلْتَقُونَ", hum: "يَلْتَقُونَ" }, // اِلْتَقَى — defective (ي)
  53: { anti: "تُصَلِّينَ", antum: "تُصَلُّونَ", hum: "يُصَلُّونَ" }, // صَلَّى — defective (ي), Form II
  54: { anti: "تَصْحِينَ", antum: "تَصْحُونَ", hum: "يَصْحُونَ" }, // صَحَا — defective (و)
  58: { anti: "تَنْسَيْنَ", antum: "تَنْسَوْنَ", hum: "يَنْسَوْنَ" }, // نَسِيَ — defective (ى)
  3: { anti: "تَقْرَئِينَ", antum: "تَقْرَءُونَ", hum: "يَقْرَءُونَ" }, // قَرَأَ — hamzated (final)
  17: { anti: "تَبْدَئِينَ", antum: "تَبْدَءُونَ", hum: "يَبْدَءُونَ" }, // بَدَأَ — hamzated (final)
};
const PRESENT_ANA_OVERRIDE = { 23: "آكُلُ" }; // أَكَلَ — the classic exception

// ---- Past-tense irregular overrides: five contracted persons for hollow
// and geminate verbs (أنا/أنتَ/أنتِ/نحن/أنتم); هو/هي/هم are unaffected
// and are safely rule-generated even for these verbs. ----
const PAST_CONTRACTED_OVERRIDES = {
  1: { ana: "أَجَبْتُ", anta: "أَجَبْتَ", anti: "أَجَبْتِ", nahnu: "أَجَبْنَا", antum: "أَجَبْتُمْ" }, // أَجَابَ — hollow (Form IV, root ج-و-ب)
  31: { ana: "نِمْتُ", anta: "نِمْتَ", anti: "نِمْتِ", nahnu: "نِمْنَا", antum: "نِمْتُمْ" }, // نَامَ — hollow
  35: { ana: "زُرْتُ", anta: "زُرْتَ", anti: "زُرْتِ", nahnu: "زُرْنَا", antum: "زُرْتُمْ" }, // زَارَ — hollow
  39: { ana: "اِسْتَرَحْتُ", anta: "اِسْتَرَحْتَ", anti: "اِسْتَرَحْتِ", nahnu: "اِسْتَرَحْنَا", antum: "اِسْتَرَحْتُمْ" }, // اِسْتَرَاحَ — hollow
  12: { ana: "أَحْبَبْتُ", anta: "أَحْبَبْتَ", anti: "أَحْبَبْتِ", nahnu: "أَحْبَبْنَا", antum: "أَحْبَبْتُمْ" }, // أَحَبَّ — geminate
  21: { ana: "ظَنَنْتُ", anta: "ظَنَنْتَ", anti: "ظَنَنْتِ", nahnu: "ظَنَنَّا", antum: "ظَنَنْتُمْ" }, // ظَنَّ — geminate
  33: { ana: "عَدَدْتُ", anta: "عَدَدْتَ", anti: "عَدَدْتِ", nahnu: "عَدَدْنَا", antum: "عَدَدْتُمْ" }, // عَدَّ — geminate
  43: { ana: "حَجَجْتُ", anta: "حَجَجْتَ", anti: "حَجَجْتِ", nahnu: "حَجَجْنَا", antum: "حَجَجْتُمْ" }, // حَجَّ — geminate
  46: { ana: "اِسْتَحْمَمْتُ", anta: "اِسْتَحْمَمْتَ", anti: "اِسْتَحْمَمْتِ", nahnu: "اِسْتَحْمَمْنَا", antum: "اِسْتَحْمَمْتُمْ" }, // اِسْتَحَمَّ — geminate
};

// ---- Past-tense full overrides: all eight persons, for the eight
// defective verbs, where nearly every person is affected. ----
const PAST_DEFECTIVE_FULL = {
  18: ["اِنْتَهَيْتُ", "اِنْتَهَيْتَ", "اِنْتَهَيْتِ", "اِنْتَهَى", "اِنْتَهَتْ", "اِنْتَهَيْنَا", "اِنْتَهَيْتُمْ", "اِنْتَهَوْا"],
  38: ["قَضَيْتُ", "قَضَيْتَ", "قَضَيْتِ", "قَضَى", "قَضَتْ", "قَضَيْنَا", "قَضَيْتُمْ", "قَضَوْا"],
  45: ["اِرْتَدَيْتُ", "اِرْتَدَيْتَ", "اِرْتَدَيْتِ", "اِرْتَدَى", "اِرْتَدَتْ", "اِرْتَدَيْنَا", "اِرْتَدَيْتُمْ", "اِرْتَدَوْا"],
  47: ["اِسْتَرْخَيْتُ", "اِسْتَرْخَيْتَ", "اِسْتَرْخَيْتِ", "اِسْتَرْخَى", "اِسْتَرْخَتْ", "اِسْتَرْخَيْنَا", "اِسْتَرْخَيْتُمْ", "اِسْتَرْخَوْا"],
  51: ["اِلْتَقَيْتُ", "اِلْتَقَيْتَ", "اِلْتَقَيْتِ", "اِلْتَقَى", "اِلْتَقَتْ", "اِلْتَقَيْنَا", "اِلْتَقَيْتُمْ", "اِلْتَقَوْا"],
  53: ["صَلَّيْتُ", "صَلَّيْتَ", "صَلَّيْتِ", "صَلَّى", "صَلَّتْ", "صَلَّيْنَا", "صَلَّيْتُمْ", "صَلَّوْا"],
  54: ["صَحَوْتُ", "صَحَوْتَ", "صَحَوْتِ", "صَحَا", "صَحَتْ", "صَحَوْنَا", "صَحَوْتُمْ", "صَحَوْا"],
  58: ["نَسِيتُ", "نَسِيتَ", "نَسِيتِ", "نَسِيَ", "نَسِيَتْ", "نَسِينَا", "نَسِيتُمْ", "نَسُوا"],
};

function ruleBasedPresent(verb) {
  const pres = verb.pres;
  const prefixVowel = pres[1]; // the diacritic on the leading يَ / يُ
  const stem = pres.slice(2);
  const stemNoFinal = stripFinalVowelMark(stem);
  return {
    ana: "أ" + prefixVowel + stem,
    anta: "ت" + prefixVowel + stem,
    anti: "ت" + prefixVowel + stemNoFinal + "ِينَ",
    huwa: pres,
    hiya: "ت" + prefixVowel + stem,
    nahnu: "ن" + prefixVowel + stem,
    antum: "ت" + prefixVowel + stemNoFinal + "ُونَ",
    hum: "ي" + prefixVowel + stemNoFinal + "ُونَ",
  };
}

function conjugatePresent(verb) {
  const form = ruleBasedPresent(verb);
  if (PRESENT_OVERRIDES[verb.id]) Object.assign(form, PRESENT_OVERRIDES[verb.id]);
  if (PRESENT_ANA_OVERRIDE[verb.id]) form.ana = PRESENT_ANA_OVERRIDE[verb.id];
  return form;
}

function conjugatePast(verb) {
  if (PAST_DEFECTIVE_FULL[verb.id]) {
    const [ana, anta, anti, huwa, hiya, nahnu, antum, hum] = PAST_DEFECTIVE_FULL[verb.id];
    return { ana, anta, anti, huwa, hiya, nahnu, antum, hum };
  }
  const past = verb.past;
  const base = stripFinalVowelMark(past);
  const baseSukoon = base + "\u0652"; // sukoon
  const form = {
    ana: baseSukoon + "تُ",
    anta: baseSukoon + "تَ",
    anti: baseSukoon + "تِ",
    huwa: past,
    hiya: base + "َتْ",
    nahnu: baseSukoon + "نَا",
    antum: baseSukoon + "تُمْ",
    hum: base + "ُوا",
  };
  if (PAST_CONTRACTED_OVERRIDES[verb.id]) Object.assign(form, PAST_CONTRACTED_OVERRIDES[verb.id]);
  return form;
}

function conjugateFuture(verb) {
  const present = conjugatePresent(verb);
  const form = {};
  Object.keys(present).forEach((k) => { form[k] = "سَ" + present[k]; });
  return form;
}

function conjugateTense(verb, tense) {
  if (tense === "past") return conjugatePast(verb);
  if (tense === "future") return conjugateFuture(verb);
  return conjugatePresent(verb);
}

const TENSES = [
  { key: "past", label: "Past" },
  { key: "present", label: "Present" },
  { key: "future", label: "Future" },
];

// ---- from utils/session.js ----
// Each preset's `size` is the total number of cards for the session —
// vocabulary and verbs together, sharing one budget.
const SESSION_SIZES = {
  quick: { label: "Quick", minutes: "~10 min", size: 11 },
  standard: { label: "Standard", minutes: "~20 min", size: 22 },
  intensive: { label: "Intensive", minutes: "~30 min", size: 32 },
};

const NEW_WORD_CAP = { quick: 3, standard: 6, intensive: 9 };

// The core-form flashcard used to reveal meaning, present tense, imperative,
// and maṣdar all at once — one fact per encounter instead, chosen at random,
// so each card asks a single question the way the vocabulary cards do.
const VERB_CORE_SKILLS = ["meaning", "present", "masdar", "imperative"];

function makeWordItem(word) {
  return { kind: "word", id: word.id, retryCount: 0 };
}
function makeVerbItem(verb) {
  const skill = VERB_CORE_SKILLS[Math.floor(Math.random() * VERB_CORE_SKILLS.length)];
  return { kind: "verb", id: verb.id, skill, retryCount: 0 };
}

function bucket(pool, predicate, type) {
  return pool.filter(predicate).map((data) => ({ type, data }));
}

/**
 * Build Today's Review: overdue and weak cards first (priority-sorted so
 * repeat mistakes surface soonest), then a conservative, load-aware
 * helping of new cards — words and verbs sharing one budget so the
 * session size shown to the learner is what they actually get.
 */
function buildTodayQueue(wordPool, verbPool, wordRecords, verbRecords, sizeKey) {
  const total = SESSION_SIZES[sizeKey].size;

  const dueAll = shuffle([
    ...bucket(wordPool, (w) => isDue(wordRecords[w.id]), "word"),
    ...bucket(verbPool, (v) => isDue(verbRecords[v.id]), "verb"),
  ]).sort((a, b) => {
    const ra = a.type === "word" ? wordRecords : verbRecords;
    const rb = b.type === "word" ? wordRecords : verbRecords;
    return priorityScore(rb[b.data.id]) - priorityScore(ra[a.data.id]);
  });

  const weakAll = shuffle([
    ...bucket(wordPool, (w) => isWeak(wordRecords[w.id]) && !isDue(wordRecords[w.id]), "word"),
    ...bucket(verbPool, (v) => isWeak(verbRecords[v.id]) && !isDue(verbRecords[v.id]), "verb"),
  ]);

  const newAll = shuffle([
    ...bucket(wordPool, (w) => isNew(wordRecords[w.id]), "word"),
    ...bucket(verbPool, (v) => isNew(verbRecords[v.id]), "verb"),
  ]);

  const baseNewCap = NEW_WORD_CAP[sizeKey];
  let effectiveNewCap = baseNewCap;
  if (dueAll.length === 0) effectiveNewCap = Math.min(newAll.length, baseNewCap * 2);
  else if (dueAll.length >= total) effectiveNewCap = Math.max(1, Math.floor(baseNewCap / 2));

  const dueTake = Math.min(dueAll.length, Math.ceil(total * 0.5));
  const weakTake = Math.min(weakAll.length, Math.ceil(total * 0.25));
  let chosen = [...dueAll.slice(0, dueTake), ...weakAll.slice(0, weakTake)];

  const remainingAfterDW = Math.max(0, total - chosen.length);
  const newTake = Math.min(newAll.length, remainingAfterDW, effectiveNewCap);
  chosen = [...chosen, ...newAll.slice(0, newTake)];

  const leftovers = shuffle([...dueAll.slice(dueTake), ...weakAll.slice(weakTake), ...newAll.slice(newTake)]);
  let li = 0;
  while (chosen.length < total && li < leftovers.length) { chosen.push(leftovers[li]); li++; }

  chosen = shuffle(chosen);
  return chosen.map(({ type, data }) => (type === "word" ? makeWordItem(data) : makeVerbItem(data)));
}

function buildUnitQueue(unitWords) {
  return shuffle(unitWords).map(makeWordItem);
}

function buildWeakPracticeQueue(weakWords, weakVerbs) {
  return shuffle([...weakWords.map(makeWordItem), ...weakVerbs.map(makeVerbItem)]);
}

function buildVerbPracticeQueue(verbs) {
  return shuffle(verbs).map(makeVerbItem);
}

/** A short, focused retry round built only from what was missed in the
 * session just finished. */
function buildMistakeReviewQueue(missedWords, missedVerbs) {
  return shuffle([...missedWords.map(makeWordItem), ...missedVerbs.map(makeVerbItem)]);
}

// ---- from utils/storage.js ----
// Persistence layer. Standard browser localStorage — no Claude-specific or
// otherwise non-standard API — so the app behaves identically in local dev,
// a production build, and after deploying to Vercel.
//
// Every read is wrapped so that missing keys, corrupted JSON, or
// localStorage being unavailable (private browsing, disabled storage, etc.)
// all fail gracefully back to sensible defaults instead of crashing.

const PREFIX = "msa-vocab:";

const KEYS = {
  wordRecords: PREFIX + "word-records",
  verbRecords: PREFIX + "verb-records",
  conjugationRecords: PREFIX + "conjugation-records",
  activeUnits: PREFIX + "active-units",
  settings: PREFIX + "settings",
  history: PREFIX + "history",
  onboarded: PREFIX + "onboarded",
};

const DEFAULT_SETTINGS = { showTranslit: false };
const DEFAULT_HISTORY = { sessions: [], streak: 0, lastStudyDate: null, totalReviewed: 0 };

let storageOk = null;

function storageAvailable() {
  if (storageOk !== null) return storageOk;
  try {
    const testKey = PREFIX + "__test__";
    window.localStorage.setItem(testKey, "1");
    window.localStorage.removeItem(testKey);
    storageOk = true;
  } catch (e) {
    storageOk = false;
  }
  return storageOk;
}

function readJson(key, fallback) {
  if (!storageAvailable()) return fallback;
  try {
    const raw = window.localStorage.getItem(key);
    if (raw == null) return fallback;
    const parsed = JSON.parse(raw);
    return parsed == null ? fallback : parsed;
  } catch (e) {
    return fallback;
  }
}

function writeJson(key, value) {
  if (!storageAvailable()) return false;
  try {
    window.localStorage.setItem(key, JSON.stringify(value));
    return true;
  } catch (e) {
    return false;
  }
}

function isPersistenceAvailable() {
  return storageAvailable();
}

function loadProgress() {
  return {
    wordRecords: readJson(KEYS.wordRecords, {}),
    verbRecords: readJson(KEYS.verbRecords, {}),
    conjugationRecords: readJson(KEYS.conjugationRecords, {}),
    history: { ...DEFAULT_HISTORY, ...readJson(KEYS.history, {}) },
  };
}

function saveWordRecords(records) { return writeJson(KEYS.wordRecords, records); }
function saveVerbRecords(records) { return writeJson(KEYS.verbRecords, records); }
function saveConjugationRecords(records) { return writeJson(KEYS.conjugationRecords, records); }
function saveHistory(history) { return writeJson(KEYS.history, history); }

function loadActiveUnits(fallback) {
  const v = readJson(KEYS.activeUnits, null);
  return Array.isArray(v) ? v : fallback;
}
function saveActiveUnits(units) { return writeJson(KEYS.activeUnits, units); }

function loadSettings() {
  return { ...DEFAULT_SETTINGS, ...readJson(KEYS.settings, {}) };
}
function saveSettings(settings) { return writeJson(KEYS.settings, settings); }

function loadOnboarded() {
  return readJson(KEYS.onboarded, false) === true;
}
function saveOnboarded(value) { return writeJson(KEYS.onboarded, value === true); }

function clearProgress() {
  writeJson(KEYS.wordRecords, {});
  writeJson(KEYS.verbRecords, {});
  writeJson(KEYS.conjugationRecords, {});
  writeJson(KEYS.history, DEFAULT_HISTORY);
}

/** Serialise everything a backup should contain — never the textbook data
 * itself, only the learner's own progress and preferences. */
function exportProgress({ wordRecords, verbRecords, conjugationRecords, activeUnits, settings, history }) {
  return JSON.stringify(
    { formatVersion: 3, exportedAt: new Date().toISOString(), wordRecords, verbRecords, conjugationRecords, activeUnits, settings, history },
    null,
    2
  );
}

/** Parse and loosely validate a pasted backup, returning null (rather than
 * throwing) if it doesn't look like one this app produced. */
function parseImport(text) {
  let data;
  try {
    data = JSON.parse(text);
  } catch (e) {
    return null;
  }
  if (!data || typeof data !== "object") return null;
  const looksValid =
    (data.wordRecords === undefined || typeof data.wordRecords === "object") &&
    (data.verbRecords === undefined || typeof data.verbRecords === "object") &&
    (data.conjugationRecords === undefined || typeof data.conjugationRecords === "object") &&
    (data.activeUnits === undefined || Array.isArray(data.activeUnits)) &&
    (data.settings === undefined || typeof data.settings === "object") &&
    (data.history === undefined || typeof data.history === "object");
  return looksValid ? data : null;
}

// ---- from components/Translit.jsx ----
// Transliteration stays hidden behind a small reveal unless the learner
// has turned it on globally in Settings — Arabic script comes first.
function Translit({ tr, showByDefault }) {
  const [revealed, setRevealed] = useState(false);
  if (showByDefault || revealed) return <div className="tr">{tr}</div>;
  return (
    <button type="button" className="translit-btn" onClick={(e) => { e.stopPropagation(); setRevealed(true); }}>
      Show pronunciation
    </button>
  );
}

// ---- from components/ConfirmDialog.jsx ----
function ConfirmDialog({ title, body, confirmLabel, onConfirm, onCancel }) {
  return (
    <div className="modal-overlay" onClick={onCancel} role="presentation">
      <div className="modal-card" onClick={(e) => e.stopPropagation()} role="dialog" aria-modal="true" aria-label={title}>
        <div className="modal-title">{title}</div>
        <div className="modal-body">{body}</div>
        <div className="modal-actions">
          <button className="btn" onClick={onCancel}>Cancel</button>
          <button className="btn primary" onClick={onConfirm}>{confirmLabel}</button>
        </div>
      </div>
    </div>
  );
}

// ---- from components/FlipCard.jsx ----
// The one visual shell every flashcard in the app uses — a large, calm
// tap-to-flip surface. What's inside the front/back is up to the caller.
function FlipCard({ flipped, onToggle, front, back }) {
  return (
    <div
      className="flashcard"
      onClick={onToggle}
      role="button"
      tabIndex={0}
      aria-label={flipped ? "Tap to show the word again" : "Tap to reveal"}
      onKeyDown={(e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); onToggle(); } }}
    >
      {!flipped ? front : back}
    </div>
  );
}

// ---- from components/OnboardingModal.jsx ----
function OnboardingModal({ onFinish }) {
  const [checked, setChecked] = useState(new Set(CATEGORIES.map((c) => c.id)));

  function toggle(id) {
    setChecked((prev) => {
      const next = new Set(prev);
      if (next.has(id)) next.delete(id); else next.add(id);
      return next;
    });
  }

  return (
    <div className="modal-overlay" role="presentation">
      <div className="modal-card" role="dialog" aria-modal="true" aria-label="Welcome">
        <div className="modal-title">Arabic Vocabulary</div>
        <div className="modal-body">
          Choose the units you've already studied. Only their vocabulary
          enters your daily review — you can change this later in Settings.
        </div>
        {CATEGORIES.map((c) => {
          const isChecked = checked.has(c.id);
          return (
            <div
              key={c.id}
              className={"onboard-row" + (isChecked ? " checked" : "")}
              onClick={() => toggle(c.id)}
              role="checkbox"
              aria-checked={isChecked}
              tabIndex={0}
              onKeyDown={(e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); toggle(c.id); } }}
            >
              <span>{c.label}</span>
              <span className="onboard-mark">{isChecked ? "✓" : "○"}</span>
            </div>
          );
        })}
        <button className="btn primary" style={{ width: "100%", marginTop: 16 }} onClick={() => onFinish([...checked])}>
          Start
        </button>
      </div>
    </div>
  );
}

// ---- from components/DailyReview.jsx ----
const MAX_RETRIES = 2; // a card can resurface at most twice in one session
const RETRY_MIN_GAP = 3;
const RETRY_MAX_GAP = 8;

// What each core-form skill asks for, and which field of the verb record
// answers it — one fact per card, same principle as the pronoun/tense
// conjugation cards elsewhere in the app.
const VERB_SKILL_LABEL = {
  meaning: "What does this mean?",
  present: "What's the present tense?",
  imperative: "What's the imperative form?",
  masdar: "What's the verbal noun (maṣdar)?",
};
const VERB_SKILL_FIELD = { meaning: "en", present: "pres", imperative: "imp", masdar: "masdar" };

/**
 * One flashcard at a time: see the word, tap to reveal, grade yourself.
 * Used for Today's Review, a single unit, weak-card practice, verb
 * practice, and the post-session mistake round — always the same simple
 * loop, never a typed question.
 */
function DailyReview({ initialQueue, title, showTranslit, wordRecords, verbRecords, gradeWord, gradeVerb, onExit, onFinish }) {
  const [items, setItems] = useState(() => initialQueue.map((it) => ({ ...it })));
  const [idx, setIdx] = useState(0);
  const [flipped, setFlipped] = useState(false);
  const [stats, setStats] = useState({ reviewed: 0, rememberedCount: 0, newCount: 0, missedKeys: [] });
  const busyRef = useRef(false); // guards against a double-tap grading the same card twice
  useEffect(() => { busyRef.current = false; }, [idx]);

  const item = items[idx];

  if (!items || items.length === 0) {
    return (
      <div className="wrap">
        <button className="back-link" onClick={onExit}>‹ Back</button>
        <div className="empty-state">Nothing to review here right now.</div>
      </div>
    );
  }

  const word = item.kind === "word" ? WORDS.find((x) => x.id === item.id) : null;
  const verb = item.kind === "verb" ? VERBS.find((x) => x.id === item.id) : null;
  const record = item.kind === "word" ? wordRecords[item.id] : verbRecords[item.id];
  const wasNew = isNew(record);

  function grade(g) {
    if (busyRef.current) return;
    busyRef.current = true;
    const correct = g !== "again";
    if (item.kind === "word") gradeWord(item.id, g); else gradeVerb(item.id, g);

    const key = item.kind + "-" + item.id;
    const nextStats = {
      reviewed: stats.reviewed + 1,
      rememberedCount: stats.rememberedCount + (correct ? 1 : 0),
      newCount: stats.newCount + (wasNew ? 1 : 0),
      missedKeys: correct ? stats.missedKeys.filter((k) => k !== key) : [...new Set([...stats.missedKeys, key])],
    };

    let nextItems = items;
    if (!correct && (item.retryCount || 0) < MAX_RETRIES) {
      const gap = RETRY_MIN_GAP + Math.floor(Math.random() * (RETRY_MAX_GAP - RETRY_MIN_GAP + 1));
      const pos = Math.min(nextItems.length, idx + 1 + gap);
      const retryItem = { ...item, retryCount: (item.retryCount || 0) + 1 };
      nextItems = [...nextItems];
      nextItems.splice(pos, 0, retryItem);
    }

    setFlipped(false);
    if (idx + 1 >= nextItems.length) {
      onFinish(nextStats);
    } else {
      setItems(nextItems);
      setStats(nextStats);
      setIdx(idx + 1);
    }
  }

  return (
    <div className="wrap">
      <div className="top-row">
        <button className="back-link" onClick={onExit}>‹ Exit</button>
        <span className="counter">{idx + 1} of {items.length}</span>
      </div>

      {item.kind === "word" && (
        <FlipCard
          flipped={flipped}
          onToggle={() => setFlipped((f) => !f)}
          front={
            <>
              <div className="card-ar">{word.ar}</div>
              <Translit tr={word.tr} showByDefault={showTranslit} />
              <div className="card-hint">Tap to reveal</div>
            </>
          }
          back={
            <>
              <div className="card-en">{word.en}</div>
              <div className="tr">{word.tr}</div>
            </>
          }
        />
      )}

      {item.kind === "verb" && (
        <FlipCard
          flipped={flipped}
          onToggle={() => setFlipped((f) => !f)}
          front={
            <>
              <div className="card-hint" style={{ marginBottom: 6 }}>{VERB_SKILL_LABEL[item.skill]}</div>
              <div className="card-ar">{verb.past}</div>
              <div className="card-hint">Tap to reveal</div>
            </>
          }
          back={
            item.skill === "meaning" ? (
              <div className="card-en">{verb.en}</div>
            ) : (
              <div className="card-ar">{verb[VERB_SKILL_FIELD[item.skill]]}</div>
            )
          }
        />
      )}

      {flipped && (
        <div className="grade-row">
          <button className="grade-btn again" onClick={() => grade("again")}>Again</button>
          <button className="grade-btn hard" onClick={() => grade("hard")}>Hard</button>
          <button className="grade-btn know" onClick={() => grade("know")}>Know it</button>
        </div>
      )}
    </div>
  );
}

// ---- from components/ResultsScreen.jsx ----
function ResultsScreen({ stats, onReviewMistakes, onDone }) {
  const missed = useMemo(() => {
    const words = [];
    const verbs = [];
    (stats.missedKeys || []).forEach((k) => {
      if (k.startsWith("word-")) {
        const w = WORDS.find((x) => x.id === Number(k.replace("word-", "")));
        if (w) words.push(w);
      } else if (k.startsWith("verb-")) {
        const v = VERBS.find((x) => x.id === Number(k.replace("verb-", "")));
        if (v) verbs.push(v);
      }
    });
    return { words, verbs, count: words.length + verbs.length };
  }, [stats]);

  return (
    <div className="wrap">
      <div className="header">
        <h1>Review complete</h1>
      </div>
      <div className="results-card">
        <div className="results-line"><strong>{stats.reviewed}</strong> cards reviewed</div>
        <div className="results-line"><strong>{stats.rememberedCount}</strong> remembered</div>
        {missed.count > 0 && (
          <div className="results-line dim">{missed.count} need more practice</div>
        )}
      </div>

      {missed.count > 0 && (
        <button className="btn primary" style={{ width: "100%", marginBottom: 12 }} onClick={() => onReviewMistakes(missed)}>
          Review missed cards
        </button>
      )}
      <button className="btn" style={{ width: "100%" }} onClick={onDone}>Done</button>
    </div>
  );
}

// ---- from components/HomeScreen.jsx ----
function HomeScreen({
  dueCount, learnedCount, learningCount, weakCount, activeUnits, wordRecords,
  verbLearnedCount, verbLearningCount,
  onStartToday, onReviewWeak, onOpenUnit, onGoVerbs, onGoProgress, onGoSettings,
}) {
  const [search, setSearch] = useState("");

  const searchResults = useMemo(() => {
    const term = search.trim().toLowerCase();
    if (!term) return [];
    return WORDS.filter(
      (w) => w.en.toLowerCase().includes(term) || w.tr.toLowerCase().includes(term) || w.ar.includes(search.trim())
    ).slice(0, 6);
  }, [search]);

  // Fix 2: due cards can be vocabulary words AND verbs, so the copy should
  // say "card(s)" rather than "word(s)". Underlying dueCount logic (passed
  // in from App) is untouched — only the label text changes here.
  const readyLine = dueCount > 0
    ? `${dueCount} card${dueCount === 1 ? "" : "s"} ready today`
    : "You're all caught up for now";

  // Fix 3: when nothing is due, the primary button should read "All caught
  // up" and be disabled rather than looking actionable with an empty queue.
  const noneDue = dueCount === 0;

  return (
    <div className="wrap">
      <div className="header">
        <h1>Arabic Vocabulary</h1>
        <p>Build your vocabulary one review at a time</p>
      </div>

      <p className="progress-line" style={{ marginBottom: 14 }}>{readyLine}</p>
      <button
        className="btn primary big"
        onClick={onStartToday}
        disabled={noneDue}
        aria-disabled={noneDue}
      >
        {noneDue ? "All caught up" : "Start Today's Review"}
      </button>

      <p className="progress-line"><strong>{learnedCount}</strong> learned · <strong>{learningCount}</strong> learning</p>

      {weakCount > 0 && (
        <div className="soft-card" onClick={onReviewWeak} role="button" tabIndex={0} onKeyDown={(e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); onReviewWeak(); } }}>
          <span>Needs more practice — {weakCount}</span>
          <span className="soft-arrow">›</span>
        </div>
      )}

      <div className="search-wrap">
        <input
          className="search-input"
          type="text"
          placeholder="Search a word…"
          value={search}
          onChange={(e) => setSearch(e.target.value)}
          aria-label="Search vocabulary"
        />
        {search.trim() && searchResults.length === 0 && (
          <div className="search-results">
            <div className="search-row" style={{ justifyContent: "center", color: "var(--text-dim)", fontSize: 13 }}>
              No matches for "{search.trim()}"
            </div>
          </div>
        )}
        {searchResults.length > 0 && (
          <div className="search-results">
            {searchResults.map((w) => (
              <div key={w.id} className="search-row">
                <div>
                  <span className="sr-ar">{w.ar}</span>
                  <div className="sr-en">{w.en}</div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <div className="section-label">Textbook Units</div>
      <div className="unit-list">
        {CATEGORIES.map((c, i) => {
          const words = WORDS.filter((w) => w.cat === c.id);
          const learnedInUnit = words.filter((w) => cardStatus(wordRecords[w.id]) === "learned").length;
          const startedInUnit = words.filter((w) => cardStatus(wordRecords[w.id]) !== "new").length;
          const pct = words.length ? Math.round((learnedInUnit / words.length) * 100) : 0;
          const isActive = activeUnits.includes(c.id);
          const statusLabel = !isActive ? "Not started" : startedInUnit === 0 ? "Not started" : learnedInUnit === words.length ? "Reviewed" : "In progress";
          return (
            <div
              key={c.id}
              className="unit-card"
              onClick={() => onOpenUnit(c.id)}
              role="button"
              tabIndex={0}
              onKeyDown={(e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); onOpenUnit(c.id); } }}
            >
              <div className="uc-top">
                <span className="uc-number">{i + 1}</span>
                <div className="uc-info">
                  <div className="uc-title">{c.label.replace(/^Unit \d+ · /, "")}</div>
                  <div className="uc-meta">{words.length} words</div>
                </div>
                <span className={"uc-status" + (isActive ? " active" : "")}>{statusLabel}</span>
              </div>
              <div className="uc-bar-track"><div className="uc-bar-fill" style={{ width: pct + "%" }} /></div>
            </div>
          );
        })}
      </div>

      <div className="section-label">Verbs</div>
      <div className="section-card" onClick={onGoVerbs} role="button" tabIndex={0} onKeyDown={(e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); onGoVerbs(); } }}>
        <div className="sc-title">Learn forms and conjugations</div>
        <div className="sc-desc">Past, present, and future tense — one verb at a time</div>
        <div className="sc-progress"><strong>{verbLearningCount}</strong> learning · <strong>{verbLearnedCount}</strong> learned</div>
        <button className="btn" onClick={(e) => { e.stopPropagation(); onGoVerbs(); }}>Study Verbs</button>
      </div>

      <div className="text-nav">
        <button onClick={onGoProgress}>Progress</button>
        <button onClick={onGoSettings}>Settings</button>
      </div>
    </div>
  );
}

// ---- from components/UnitView.jsx ----
function UnitView({ unit, isActive, toggleActive, wordRecords, showTranslit, onBack, onPractice }) {
  const [openWordId, setOpenWordId] = useState(null);
  const words = WORDS.filter((w) => w.cat === unit.id);
  const openWord = openWordId ? words.find((w) => w.id === openWordId) : null;

  return (
    <div className="wrap">
      <div className="top-row">
        <button className="back-link" onClick={onBack}>‹ Back</button>
        <span className="counter">{unit.label}</span>
      </div>

      <div className="unit-toolbar">
        <button
          className={"chip-toggle" + (isActive ? " on" : "")}
          onClick={toggleActive}
          aria-pressed={isActive}
        >
          {isActive ? "Active" : "Not started"}
        </button>
        <button className="btn primary" onClick={onPractice}>Practise this unit</button>
      </div>

      <div className="word-list">
        {words.map((w) => {
          const status = cardStatus(wordRecords[w.id]);
          return (
            <div key={w.id} className="word-list-row" onClick={() => setOpenWordId(w.id)} role="button" tabIndex={0} onKeyDown={(e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); setOpenWordId(w.id); } }}>
              <div>
                <span className="wl-ar">{w.ar}</span>
                <div className="wl-en">{w.en}</div>
              </div>
              {status === "learned" && <span className="wl-dot" aria-label="Learned" />}
            </div>
          );
        })}
      </div>

      {openWord && (
        <div className="modal-overlay" onClick={() => setOpenWordId(null)}>
          <div className="modal-card modal-card-wide" onClick={(e) => e.stopPropagation()}>
            <div className="flashcard" style={{ cursor: "default" }}>
              <div className="card-ar">{openWord.ar}</div>
              <Translit tr={openWord.tr} showByDefault={showTranslit} />
              <div className="card-en" style={{ marginTop: 14 }}>{openWord.en}</div>
            </div>
            <button className="btn" style={{ width: "100%", marginTop: 14 }} onClick={() => setOpenWordId(null)}>Close</button>
          </div>
        </div>
      )}
    </div>
  );
}

// ---- from components/VerbsLibrary.jsx ----
function VerbsLibrary({ verbRecords, onBack, onOpenVerb, onPractice, learnedCount, learningCount }) {
  const [search, setSearch] = useState("");

  const filtered = useMemo(() => {
    const term = search.trim().toLowerCase();
    if (!term) return VERBS;
    return VERBS.filter((v) => v.en.toLowerCase().includes(term) || v.past.includes(search.trim()));
  }, [search]);

  return (
    <div className="wrap">
      <div className="top-row">
        <button className="back-link" onClick={onBack}>‹ Back</button>
        <span className="counter">Verbs</span>
      </div>

      <p className="progress-line"><strong>{learnedCount}</strong> learned · <strong>{learningCount}</strong> learning</p>

      <button className="btn primary" style={{ width: "100%", marginBottom: 18 }} onClick={onPractice}>
        Practise Verbs
      </button>

      <div className="search-wrap">
        <input
          className="search-input"
          type="text"
          placeholder="Search a verb…"
          value={search}
          onChange={(e) => setSearch(e.target.value)}
          aria-label="Search verbs"
        />
      </div>

      <div className="section-label">Verb Library</div>
      {filtered.length === 0 ? (
        <div className="empty-state">No verbs match "{search.trim()}"</div>
      ) : (
        <div className="verb-list">
          {filtered.map((v) => {
            const status = cardStatus(verbRecords[v.id]);
            return (
              <div key={v.id} className="verb-list-row" onClick={() => onOpenVerb(v.id)} role="button" tabIndex={0} onKeyDown={(e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); onOpenVerb(v.id); } }}>
                <div>
                  <div className="vl-ar">{v.past}</div>
                  <div className="vl-en">{v.en}</div>
                  <div className="vl-pres">Present: {v.pres}</div>
                </div>
                {status === "learned" && <span className="wl-dot" aria-label={STATUS_LABEL.learned} />}
              </div>
            );
          })}
        </div>
      )}
    </div>
  );
}

// ---- from components/VerbDetail.jsx ----
function VerbDetail({ verbId, onBack, onStudyTense }) {
  const [tense, setTense] = useState("present");
  const verb = VERBS.find((v) => v.id === verbId);
  if (!verb) return null;

  const forms = conjugateTense(verb, tense);

  return (
    <div className="wrap">
      <div className="top-row">
        <button className="back-link" onClick={onBack}>‹ Back</button>
        <span className="counter">Verb</span>
      </div>

      <div className="verb-hero">
        <div className="vh-ar">{verb.past}</div>
        <div className="vh-en">{verb.en}</div>
      </div>

      <div className="core-forms">
        <div className="core-form-row"><span className="cf-label">Past</span><span className="cf-value">{verb.past}</span></div>
        <div className="core-form-row"><span className="cf-label">Present</span><span className="cf-value">{verb.pres}</span></div>
        <div className="core-form-row"><span className="cf-label">Imperative</span><span className="cf-value">{verb.imp}</span></div>
        <div className="core-form-row"><span className="cf-label">Verbal noun</span><span className="cf-value">{verb.masdar}</span></div>
      </div>

      <div className="tense-tabs">
        {TENSES.map((t) => (
          <button key={t.key} className={"tense-tab" + (tense === t.key ? " active" : "")} onClick={() => setTense(t.key)}>
            {t.label}
          </button>
        ))}
      </div>

      <div className="conj-list">
        {PRONOUNS.map((p) => (
          <div key={p.key} className="conj-row">
            <span className="cr-pronoun">{p.ar}</span>
            <span className="cr-form">{forms[p.key]}</span>
          </div>
        ))}
      </div>

      <button className="btn primary" style={{ width: "100%" }} onClick={() => onStudyTense(verb.id, tense)}>
        Study {TENSES.find((t) => t.key === tense).label} Tense
      </button>
    </div>
  );
}

// ---- from components/ConjugationReview.jsx ----
const CONJ_MAX_RETRIES = 1;
const CONJ_RETRY_MIN_GAP = 2;
const CONJ_RETRY_MAX_GAP = 4;

function ConjugationReview({ verbId, tense, gradeConjugation, onExit, onFinish }) {
  const verb = VERBS.find((v) => v.id === verbId);
  const [items, setItems] = useState(() => PRONOUNS.map((p) => ({ pronoun: p.key, retryCount: 0 })));
  const [idx, setIdx] = useState(0);
  const [flipped, setFlipped] = useState(false);
  const [stats, setStats] = useState({ reviewed: 0, rememberedCount: 0 });
  const busyRef = useRef(false); // guards against a double-tap grading the same card twice
  useEffect(() => { busyRef.current = false; }, [idx]);

  if (!verb) return null;

  const forms = conjugateTense(verb, tense);
  const tenseLabel = TENSES.find((t) => t.key === tense)?.label || tense;
  const item = items[idx];
  const pronoun = PRONOUNS.find((p) => p.key === item.pronoun);

  function grade(g) {
    if (busyRef.current) return;
    busyRef.current = true;
    const correct = g !== "again";
    gradeConjugation(verb.id, tense, item.pronoun, g);

    const nextStats = { reviewed: stats.reviewed + 1, rememberedCount: stats.rememberedCount + (correct ? 1 : 0) };

    let nextItems = items;
    if (!correct && (item.retryCount || 0) < CONJ_MAX_RETRIES) {
      const gap = CONJ_RETRY_MIN_GAP + Math.floor(Math.random() * (CONJ_RETRY_MAX_GAP - CONJ_RETRY_MIN_GAP + 1));
      const pos = Math.min(nextItems.length, idx + 1 + gap);
      const retryItem = { ...item, retryCount: (item.retryCount || 0) + 1 };
      nextItems = [...nextItems];
      nextItems.splice(pos, 0, retryItem);
    }

    setFlipped(false);
    if (idx + 1 >= nextItems.length) {
      onFinish(nextStats);
    } else {
      setItems(nextItems);
      setStats(nextStats);
      setIdx(idx + 1);
    }
  }

  return (
    <div className="wrap">
      <div className="top-row">
        <button className="back-link" onClick={onExit}>‹ Exit</button>
        <span className="counter">{idx + 1} of {items.length}</span>
      </div>

      <FlipCard
        flipped={flipped}
        onToggle={() => setFlipped((f) => !f)}
        front={
          <>
            <div className="card-hint" style={{ marginBottom: 4 }}>{pronoun.ar} — {tenseLabel}</div>
            <div className="card-ar">{verb.past}</div>
            <div className="card-hint">Tap to reveal</div>
          </>
        }
        back={
          <>
            <div className="card-hint" style={{ marginBottom: 4 }}>{pronoun.ar} — {tenseLabel}</div>
            <div className="card-ar">{forms[item.pronoun]}</div>
          </>
        }
      />

      {flipped && (
        <div className="grade-row">
          <button className="grade-btn again" onClick={() => grade("again")}>Again</button>
          <button className="grade-btn hard" onClick={() => grade("hard")}>Hard</button>
          <button className="grade-btn know" onClick={() => grade("know")}>Know it</button>
        </div>
      )}
    </div>
  );
}

// ---- from components/ConjugationDone.jsx ----
function ConjugationDone({ stats, onDone }) {
  return (
    <div className="wrap">
      <div className="header"><h1>Nicely done</h1></div>
      <div className="results-card">
        <div className="results-line"><strong>{stats.reviewed}</strong> forms reviewed</div>
        <div className="results-line dim">{stats.rememberedCount} remembered</div>
      </div>
      <button className="btn primary" style={{ width: "100%" }} onClick={onDone}>Done</button>
    </div>
  );
}

// ---- from components/ProgressScreen.jsx ----
function ProgressScreen({ history, activeWordPool, activeUnitsCount, wordRecords, verbLearnedCount, verbLearningCount, onBack }) {
  const counts = useMemo(() => {
    const c = { new: 0, learning: 0, learned: 0 };
    activeWordPool.forEach((w) => { c[cardStatus(wordRecords[w.id])]++; });
    return c;
  }, [activeWordPool, wordRecords]);

  return (
    <div className="wrap">
      <div className="top-row">
        <button className="back-link" onClick={onBack}>‹ Back</button>
        <span className="counter">Progress</span>
      </div>

      <div className="progress-grid">
        <div className="progress-cell">
          <div className="pc-value">{counts.learned}</div>
          <div className="pc-label">Learned</div>
        </div>
        <div className="progress-cell">
          <div className="pc-value">{counts.learning}</div>
          <div className="pc-label">Learning</div>
        </div>
        <div className="progress-cell">
          <div className="pc-value">{activeUnitsCount}</div>
          <div className="pc-label">Units active</div>
        </div>
        <div className="progress-cell">
          <div className="pc-value">{(history.sessions || []).length}</div>
          <div className="pc-label">Sessions</div>
        </div>
      </div>

      {(history.streak || 0) > 0 && (
        <p className="streak-line">{history.streak}-day study streak</p>
      )}

      <div className="section-label">Verbs</div>
      <p className="progress-line"><strong>{verbLearningCount}</strong> learning · <strong>{verbLearnedCount}</strong> learned</p>
    </div>
  );
}

// ---- from components/SettingsScreen.jsx ----
function SettingsScreen({
  settings, updateSettings, activeUnits, toggleUnitActive,
  wordRecords, verbRecords, conjugationRecords, history, onImport, onReset, onBack,
}) {
  const [showBackup, setShowBackup] = useState(false);
  const [importText, setImportText] = useState("");
  const [message, setMessage] = useState("");

  const exportJson = useMemo(
    () => exportProgress({ wordRecords, verbRecords, conjugationRecords, activeUnits, settings, history }),
    [wordRecords, verbRecords, conjugationRecords, activeUnits, settings, history]
  );

  function handleCopy() {
    try {
      const result = navigator.clipboard && navigator.clipboard.writeText(exportJson);
      if (result && typeof result.then === "function") {
        result
          .then(() => setMessage("Copied to clipboard."))
          .catch(() => setMessage("Couldn't copy automatically — select and copy the text manually."));
      } else {
        setMessage("Couldn't copy automatically — select and copy the text manually.");
      }
    } catch (e) {
      setMessage("Couldn't copy automatically — select and copy the text manually.");
    }
  }

  function handleImport() {
    const data = parseImport(importText);
    if (!data) { setMessage("That didn't look like a valid backup."); return; }
    onImport(data);
    setMessage("Progress imported.");
    setImportText("");
  }

  return (
    <div className="wrap">
      <div className="top-row">
        <button className="back-link" onClick={onBack}>‹ Back</button>
        <span className="counter">Settings</span>
      </div>

      <div className="setting-row">
        <span>Show transliteration</span>
        <div
          className={"toggle-switch" + (settings.showTranslit ? " on" : "")}
          onClick={() => updateSettings({ showTranslit: !settings.showTranslit })}
          role="switch"
          aria-checked={settings.showTranslit}
          tabIndex={0}
          onKeyDown={(e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); updateSettings({ showTranslit: !settings.showTranslit }); } }}
        >
          <div className="toggle-knob" />
        </div>
      </div>

      <div className="section-label">Active units</div>
      <div className="unit-list">
        {CATEGORIES.map((c) => {
          const isActive = activeUnits.includes(c.id);
          return (
            <div key={c.id} className="unit-list-row" onClick={() => toggleUnitActive(c.id)} role="button" tabIndex={0} onKeyDown={(e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); toggleUnitActive(c.id); } }}>
              <span>{c.label}</span>
              <span className="soft-arrow">{isActive ? "✓" : "○"}</span>
            </div>
          );
        })}
      </div>

      <div className="section-label">Backup</div>
      <button className="btn" style={{ width: "100%", marginBottom: 10 }} onClick={() => setShowBackup((s) => !s)}>
        {showBackup ? "Hide backup" : "Export / import progress"}
      </button>
      {showBackup && (
        <>
          <textarea className="export-area" readOnly value={exportJson} aria-label="Exported progress" />
          <button className="btn" style={{ width: "100%", marginTop: 8, marginBottom: 14 }} onClick={handleCopy}>Copy to clipboard</button>
          <textarea
            className="export-area"
            placeholder="Paste a backup here to restore it…"
            value={importText}
            onChange={(e) => setImportText(e.target.value)}
            aria-label="Paste backup to import"
          />
          <button className="btn" style={{ width: "100%", marginTop: 8 }} onClick={handleImport} disabled={!importText.trim()}>
            Import
          </button>
        </>
      )}
      {message && <p className="settings-message">{message}</p>}

      <button className="btn danger" style={{ marginTop: 18 }} onClick={onReset}>Reset progress…</button>
    </div>
  );
}

// ---- from App.jsx ----
const TENSE_KEYS = ["past", "present", "future"];
const PRONOUN_KEYS = ["ana", "anta", "anti", "huwa", "hiya", "nahnu", "antum", "hum"];

function App() {
  const [progress, setProgress] = useState(() => loadProgress());
  const [activeUnits, setActiveUnits] = useState(() => loadActiveUnits(CATEGORIES.map((c) => c.id)));
  const [settings, setSettings] = useState(() => loadSettings());
  const [onboarded, setOnboarded] = useState(() => loadOnboarded());

  const [screen, setScreen] = useState("home");
  const [currentUnitId, setCurrentUnitId] = useState(null);
  const [currentVerbId, setCurrentVerbId] = useState(null);
  const [conjSessionConfig, setConjSessionConfig] = useState(null); // { verbId, tense }
  const [conjResults, setConjResults] = useState(null);
  const [sessionConfig, setSessionConfig] = useState(null); // { queue, title }
  const [lastResults, setLastResults] = useState(null);
  const [confirmReset, setConfirmReset] = useState(false);

  const wordRecords = progress.wordRecords;
  const verbRecords = progress.verbRecords;
  const conjugationRecords = progress.conjugationRecords;
  const history = progress.history;

  const gradeWord = useCallback((id, grade) => {
    setProgress((prev) => {
      const wordRecords = { ...prev.wordRecords, [id]: applyGrade(prev.wordRecords[id], grade) };
      saveWordRecords(wordRecords);
      return { ...prev, wordRecords };
    });
  }, []);

  const gradeVerb = useCallback((id, grade) => {
    setProgress((prev) => {
      const verbRecords = { ...prev.verbRecords, [id]: applyGrade(prev.verbRecords[id], grade) };
      saveVerbRecords(verbRecords);
      return { ...prev, verbRecords };
    });
  }, []);

  const gradeConjugation = useCallback((verbId, tense, pronoun, grade) => {
    const key = verbId + "-" + tense + "-" + pronoun;
    setProgress((prev) => {
      const conjugationRecords = { ...prev.conjugationRecords, [key]: applyGrade(prev.conjugationRecords[key], grade) };
      saveConjugationRecords(conjugationRecords);
      return { ...prev, conjugationRecords };
    });
  }, []);

  const toggleUnitActive = useCallback((catId) => {
    setActiveUnits((prev) => {
      const next = prev.includes(catId) ? prev.filter((c) => c !== catId) : [...prev, catId];
      saveActiveUnits(next);
      return next;
    });
  }, []);

  const updateSettings = useCallback((patch) => {
    setSettings((prev) => {
      const next = { ...prev, ...patch };
      saveSettings(next);
      return next;
    });
  }, []);

  const finishOnboarding = useCallback((units) => {
    setActiveUnits(units);
    saveActiveUnits(units);
    setOnboarded(true);
    saveOnboarded(true);
  }, []);

  const recordSessionResult = useCallback((stats) => {
    setProgress((prev) => {
      const todayStr = new Date().toDateString();
      const prevHistory = prev.history;
      const wasYesterday = prevHistory.lastStudyDate &&
        new Date(prevHistory.lastStudyDate).toDateString() !== todayStr &&
        Date.now() - new Date(prevHistory.lastStudyDate).getTime() < 2 * 86400000;
      const alreadyToday = prevHistory.lastStudyDate && new Date(prevHistory.lastStudyDate).toDateString() === todayStr;
      const nextStreak = alreadyToday ? prevHistory.streak : (wasYesterday ? prevHistory.streak + 1 : 1);
      const sessions = [...prevHistory.sessions, {
        date: new Date().toISOString(), reviewed: stats.reviewed, remembered: stats.rememberedCount,
      }].slice(-60);
      const nextHistory = { sessions, streak: nextStreak, lastStudyDate: new Date().toISOString(), totalReviewed: (prevHistory.totalReviewed || 0) + stats.reviewed };
      saveHistory(nextHistory);
      return { ...prev, history: nextHistory };
    });
  }, []);

  const resetProgress = useCallback(() => {
    setProgress({ wordRecords: {}, verbRecords: {}, conjugationRecords: {}, history: DEFAULT_HISTORY });
    clearProgress();
    setConfirmReset(false);
    setScreen("home");
  }, []);

  const importProgressData = useCallback((data) => {
    const validWordIds = new Set(WORDS.map((w) => w.id));
    const validVerbIds = new Set(VERBS.map((v) => v.id));
    const validUnitIds = new Set(CATEGORIES.map((c) => c.id));

    setProgress((prev) => {
      let next = prev;
      if (data.wordRecords) {
        const sanitized = {};
        Object.keys(data.wordRecords).forEach((k) => { if (validWordIds.has(Number(k))) sanitized[k] = data.wordRecords[k]; });
        saveWordRecords(sanitized);
        next = { ...next, wordRecords: sanitized };
      }
      if (data.verbRecords) {
        const sanitized = {};
        Object.keys(data.verbRecords).forEach((k) => { if (validVerbIds.has(Number(k))) sanitized[k] = data.verbRecords[k]; });
        saveVerbRecords(sanitized);
        next = { ...next, verbRecords: sanitized };
      }
      if (data.conjugationRecords) {
        const sanitized = {};
        Object.keys(data.conjugationRecords).forEach((k) => {
          const [verbIdStr, tense, pronoun] = k.split("-");
          if (validVerbIds.has(Number(verbIdStr)) && TENSE_KEYS.includes(tense) && PRONOUN_KEYS.includes(pronoun)) {
            sanitized[k] = data.conjugationRecords[k];
          }
        });
        saveConjugationRecords(sanitized);
        next = { ...next, conjugationRecords: sanitized };
      }
      if (data.history) {
        const nextHistory = { ...DEFAULT_HISTORY, ...data.history };
        saveHistory(nextHistory);
        next = { ...next, history: nextHistory };
      }
      return next;
    });
    if (Array.isArray(data.activeUnits)) {
      const sanitized = data.activeUnits.filter((u) => validUnitIds.has(u));
      setActiveUnits(sanitized);
      saveActiveUnits(sanitized);
    }
    if (data.settings) {
      setSettings((prev) => { const next = { ...prev, ...data.settings }; saveSettings(next); return next; });
    }
  }, []);

  const activeWordPool = useMemo(() => WORDS.filter((w) => activeUnits.includes(w.cat)), [activeUnits]);
  const activeVerbPool = useMemo(
    () => VERBS.filter((v) => v.unit === "Intro" || activeUnits.includes("u" + v.unit)),
    [activeUnits]
  );

  const dueCount = useMemo(() => {
    const dueWords = activeWordPool.filter((w) => isDue(wordRecords[w.id])).length;
    const dueVerbs = activeVerbPool.filter((v) => isDue(verbRecords[v.id])).length;
    return dueWords + dueVerbs;
  }, [activeWordPool, activeVerbPool, wordRecords, verbRecords]);

  const learnedCount = useMemo(() => activeWordPool.filter((w) => cardStatus(wordRecords[w.id]) === "learned").length, [activeWordPool, wordRecords]);
  const learningCount = useMemo(() => activeWordPool.filter((w) => cardStatus(wordRecords[w.id]) === "learning").length, [activeWordPool, wordRecords]);

  const verbLearnedCount = useMemo(() => VERBS.filter((v) => cardStatus(verbRecords[v.id]) === "learned").length, [verbRecords]);
  const verbLearningCount = useMemo(() => VERBS.filter((v) => cardStatus(verbRecords[v.id]) === "learning").length, [verbRecords]);

  const weakWords = useMemo(() => activeWordPool.filter((w) => isWeak(wordRecords[w.id])), [activeWordPool, wordRecords]);
  const weakVerbs = useMemo(() => activeVerbPool.filter((v) => isWeak(verbRecords[v.id])), [activeVerbPool, verbRecords]);

  const startTodayReview = useCallback(() => {
    const queue = buildTodayQueue(activeWordPool, activeVerbPool, wordRecords, verbRecords, "standard");
    if (queue.length === 0) return;
    setSessionConfig({ queue, title: "Today's Review" });
    setScreen("session");
  }, [activeWordPool, activeVerbPool, wordRecords, verbRecords]);

  const startUnitPractice = useCallback((catId) => {
    const words = WORDS.filter((w) => w.cat === catId);
    const queue = buildUnitQueue(words);
    setSessionConfig({ queue, title: CATEGORIES.find((c) => c.id === catId)?.label || "Unit" });
    setScreen("session");
  }, []);

  // Fix 4: "Practise Verbs" should respect the user's active textbook units,
  // the same way vocabulary practice does — use activeVerbPool (which
  // already includes all "Intro" verbs plus verbs whose unit is active)
  // instead of the full VERBS list. If every unit is active, activeVerbPool
  // naturally contains every relevant verb, so behaviour is unchanged for
  // that case. The daily mixed review (startTodayReview) already used
  // activeVerbPool and is untouched.
  const startVerbPractice = useCallback(() => {
    const queue = buildVerbPracticeQueue(activeVerbPool);
    if (queue.length === 0) return;
    setSessionConfig({ queue, title: "Verbs" });
    setScreen("session");
  }, [activeVerbPool]);

  const startWeakPractice = useCallback(() => {
    if (weakWords.length === 0 && weakVerbs.length === 0) return;
    const queue = buildWeakPracticeQueue(weakWords, weakVerbs);
    setSessionConfig({ queue, title: "Needs More Practice" });
    setScreen("session");
  }, [weakWords, weakVerbs]);

  const startReviewMistakes = useCallback((missed) => {
    const queue = buildMistakeReviewQueue(missed.words, missed.verbs);
    setSessionConfig({ queue, title: "Missed Cards" });
    setScreen("session");
  }, []);

  const handleSessionFinish = useCallback((stats) => {
    recordSessionResult(stats);
    setLastResults(stats);
    setSessionConfig(null);
    setScreen("results");
  }, [recordSessionResult]);

  const startConjugationStudy = useCallback((verbId, tense) => {
    setConjSessionConfig({ verbId, tense });
    setScreen("conjSession");
  }, []);

  const handleConjugationFinish = useCallback((stats) => {
    setConjResults(stats);
    setConjSessionConfig(null);
    setScreen("conjDone");
  }, []);

  const currentUnit = currentUnitId ? CATEGORIES.find((c) => c.id === currentUnitId) : null;

  return (
    <div className="app-root">
      {!onboarded && <OnboardingModal onFinish={finishOnboarding} />}

      {confirmReset && (
        <ConfirmDialog
          title="Reset progress?"
          body="This clears every card's learning history and your study streak. Your textbook vocabulary and verbs are never touched — only your progress through them."
          confirmLabel="Reset progress"
          onConfirm={resetProgress}
          onCancel={() => setConfirmReset(false)}
        />
      )}

      {screen === "home" && (
        <HomeScreen
          dueCount={dueCount}
          learnedCount={learnedCount}
          learningCount={learningCount}
          weakCount={weakWords.length + weakVerbs.length}
          activeUnits={activeUnits}
          wordRecords={wordRecords}
          verbLearnedCount={verbLearnedCount}
          verbLearningCount={verbLearningCount}
          onStartToday={startTodayReview}
          onReviewWeak={startWeakPractice}
          onOpenUnit={(catId) => { setCurrentUnitId(catId); setScreen("unit"); }}
          onGoVerbs={() => setScreen("verbsLibrary")}
          onGoProgress={() => setScreen("progress")}
          onGoSettings={() => setScreen("settings")}
        />
      )}

      {screen === "session" && sessionConfig && (
        <DailyReview
          initialQueue={sessionConfig.queue}
          title={sessionConfig.title}
          showTranslit={settings.showTranslit}
          wordRecords={wordRecords}
          verbRecords={verbRecords}
          gradeWord={gradeWord}
          gradeVerb={gradeVerb}
          onExit={() => { setSessionConfig(null); setScreen("home"); }}
          onFinish={handleSessionFinish}
        />
      )}

      {screen === "results" && lastResults && (
        <ResultsScreen stats={lastResults} onReviewMistakes={startReviewMistakes} onDone={() => setScreen("home")} />
      )}

      {screen === "unit" && currentUnit && (
        <UnitView
          unit={currentUnit}
          isActive={activeUnits.includes(currentUnit.id)}
          toggleActive={() => toggleUnitActive(currentUnit.id)}
          wordRecords={wordRecords}
          showTranslit={settings.showTranslit}
          onBack={() => setScreen("home")}
          onPractice={() => startUnitPractice(currentUnit.id)}
        />
      )}

      {screen === "verbsLibrary" && (
        <VerbsLibrary
          verbRecords={verbRecords}
          learnedCount={verbLearnedCount}
          learningCount={verbLearningCount}
          onBack={() => setScreen("home")}
          onPractice={startVerbPractice}
          onOpenVerb={(verbId) => { setCurrentVerbId(verbId); setScreen("verbDetail"); }}
        />
      )}

      {screen === "verbDetail" && currentVerbId && (
        <VerbDetail
          verbId={currentVerbId}
          onBack={() => setScreen("verbsLibrary")}
          onStudyTense={startConjugationStudy}
        />
      )}

      {screen === "conjSession" && conjSessionConfig && (
        <ConjugationReview
          verbId={conjSessionConfig.verbId}
          tense={conjSessionConfig.tense}
          gradeConjugation={gradeConjugation}
          onExit={() => { setConjSessionConfig(null); setScreen("verbDetail"); }}
          onFinish={handleConjugationFinish}
        />
      )}

      {screen === "conjDone" && conjResults && (
        <ConjugationDone stats={conjResults} onDone={() => setScreen("verbDetail")} />
      )}

      {screen === "progress" && (
        <ProgressScreen
          history={history}
          activeWordPool={activeWordPool}
          activeUnitsCount={activeUnits.length}
          wordRecords={wordRecords}
          verbLearnedCount={verbLearnedCount}
          verbLearningCount={verbLearningCount}
          onBack={() => setScreen("home")}
        />
      )}

      {screen === "settings" && (
        <SettingsScreen
          settings={settings}
          updateSettings={updateSettings}
          activeUnits={activeUnits}
          toggleUnitActive={toggleUnitActive}
          wordRecords={wordRecords}
          verbRecords={verbRecords}
          conjugationRecords={conjugationRecords}
          history={history}
          onImport={importProgressData}
          onReset={() => setConfirmReset(true)}
          onBack={() => setScreen("home")}
        />
      )}
    </div>
  );
}


ReactDOM.createRoot(document.getElementById("root")).render(<App />);
</script>
</body>
</html>
