<!doctype html>
<html lang="en">
<head>
  <link rel="apple-touch-icon" sizes="180x180" href="./apple-touch-icon.png">
<link rel="icon" type="image/png" href="./apple-touch-icon.png">
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Arabic Vocabulary</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.production.min.js"></script>
<script>
(function () {
  var originalWarn = console.warn.bind(console);
  console.warn = function () {
    if (typeof arguments[0] === "string" && arguments[0].indexOf("in-browser Babel transformer") !== -1) return;
    originalWarn.apply(console, arguments);
  };
})();
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.24.7/babel.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Lora:ital,wght@0,500;0,600;1,500&family=Work+Sans:wght@400;500;600;700&display=swap');

* { box-sizing: border-box; }
html, body, #root { height: 100%; }
body { margin: 0; }

.app-root {
  --bg: #f2ebe0;
  --surface: #fbf7f0;
  --surface-raised: #fdfaf5;
  --line: #ddd0ba;
  --text: #2c2521;
  --text-dim: #8a7d6c;
  --accent: #7c3f45;
  --accent-strong: #602f34;
  --accent-soft: #f0dcdd;
  --accent-wash: rgba(124, 63, 69, 0.09);
  --gold: #ad8a52;
  --gold-strong: #8f7040;
  --gold-wash: rgba(173, 138, 82, 0.14);
  --warn: #a15c3a;
  --warn-wash: rgba(161, 92, 58, 0.10);
  --shadow-sm: 0 2px 8px rgba(44, 37, 33, 0.06);
  --shadow-md: 0 10px 26px rgba(44, 37, 33, 0.09);
  font-family: 'Work Sans', sans-serif;
  background:
    radial-gradient(circle at 12% -8%, rgba(124,63,69,0.05) 0%, transparent 45%),
    radial-gradient(circle at 100% 15%, rgba(173,138,82,0.06) 0%, transparent 42%),
    var(--bg);
  background-attachment: fixed;
  color: var(--text);
  min-height: 100vh;
  padding: 34px 20px 48px;
}
.app-root * { box-sizing: border-box; }
.app-root button { font-family: 'Work Sans', sans-serif; }
.app-root button:focus-visible, .app-root input:focus-visible, .app-root textarea:focus-visible {
  outline: 2px solid var(--accent); outline-offset: 2px;
}
.arabic { font-family: 'Amiri', serif; direction: rtl; }
.wrap { max-width: 440px; margin: 0 auto; }

/* ---- Header ---- */
.header { text-align: center; margin-bottom: 30px; }
.header h1 { margin: 0; font-family: 'Lora', serif; font-size: 27px; font-weight: 600; letter-spacing: -0.005em; color: var(--text); }
.header p { margin: 9px 0 0; color: var(--text-dim); font-size: 14px; }
.header::after {
  content: ""; display: block; width: 44px; height: 2px; background: var(--gold);
  margin: 18px auto 0; border-radius: 1px;
}

.top-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
.back-link { background: none; border: none; color: var(--text-dim); font-size: 15px; cursor: pointer; padding: 6px 2px; transition: color 0.15s ease; }
.back-link:hover { color: var(--accent); }
.counter { font-size: 13px; color: var(--text-dim); font-weight: 500; letter-spacing: 0.02em; }

/* ---- Buttons ---- */
.btn {
  padding: 14px 18px; min-height: 48px; border-radius: 12px; border: 1px solid var(--line);
  background: var(--surface); color: var(--text); font-size: 15px; font-weight: 500; cursor: pointer;
  transition: transform 0.12s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}
.btn:active { transform: scale(0.98); }
.btn.primary {
  background: var(--accent);
  border-color: var(--accent);
  color: #fbf3ee;
  font-weight: 600;
  box-shadow: 0 6px 18px rgba(124,63,69,0.24), inset 0 1px 0 rgba(255,255,255,0.14);
}
.btn.primary:hover { background: var(--accent-strong); border-color: var(--accent-strong); }
.btn.big { width: 100%; padding: 20px; font-size: 17px; margin-bottom: 24px; border-radius: 14px; }
.btn.danger { width: 100%; border-color: var(--warn); color: var(--warn); background: transparent; box-shadow: none; }
.btn:disabled { opacity: 0.5; cursor: default; transform: none; }

.progress-line { text-align: center; color: var(--text-dim); font-size: 14px; margin: 0 0 28px; letter-spacing: 0.01em; }
.progress-line strong { color: var(--text); font-weight: 600; }

/* ---- Home: soft card / section card / unit list / nav ---- */
.soft-card {
  display: flex; justify-content: space-between; align-items: center;
  background: var(--surface); border: 1px solid var(--line); border-radius: 14px;
  padding: 18px 20px; margin-bottom: 24px; cursor: pointer; font-size: 14px;
  box-shadow: var(--shadow-sm);
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.soft-card:hover { border-color: var(--accent); box-shadow: var(--shadow-md); }
.soft-arrow { color: var(--gold-strong); font-size: 16px; }

.section-label {
  font-size: 12px; text-transform: uppercase; letter-spacing: 0.09em; color: var(--text-dim);
  margin: 32px 0 13px; font-weight: 600; display: flex; align-items: center; gap: 10px;
}
.section-label::after { content: ""; flex: 1; height: 1px; background: var(--line); }

.section-card {
  background: var(--surface); border: 1px solid var(--line); border-radius: 16px;
  padding: 24px; margin-bottom: 8px; box-shadow: var(--shadow-sm); cursor: pointer;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
  position: relative;
}
.section-card:hover { box-shadow: var(--shadow-md); }
.section-card::before {
  content: ""; position: absolute; top: 24px; bottom: 24px; left: 0; width: 3px;
  background: var(--gold); border-radius: 0 3px 3px 0;
}
.section-card .sc-title { font-family: 'Lora', serif; font-size: 18px; font-weight: 600; margin-bottom: 5px; }
.section-card .sc-desc { font-size: 13px; color: var(--text-dim); margin-bottom: 16px; }
.section-card .sc-progress { font-size: 13px; color: var(--text-dim); margin-bottom: 18px; }
.section-card .sc-progress strong { color: var(--text); }
.section-card .btn { width: 100%; }

.unit-list { display: flex; flex-direction: column; gap: 10px; }
.unit-list-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 15px 16px; min-height: 48px; background: var(--surface); border: 1px solid var(--line);
  border-radius: 10px; cursor: pointer; font-size: 14px; transition: border-color 0.15s ease;
}
.unit-list-row:hover { border-color: var(--accent); }
.unit-card {
  background: var(--surface); border: 1px solid var(--line); border-radius: 14px;
  padding: 17px 19px; cursor: pointer; box-shadow: var(--shadow-sm);
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.unit-card:hover { border-color: var(--accent); box-shadow: var(--shadow-md); }
.unit-card .uc-top { display: flex; align-items: center; gap: 13px; }
.uc-number {
  width: 33px; height: 33px; border-radius: 50%; background: var(--accent-soft);
  color: var(--accent-strong); display: flex; align-items: center; justify-content: center;
  font-family: 'Lora', serif; font-weight: 600; font-size: 14px; flex-shrink: 0;
}
.uc-info { flex: 1; min-width: 0; }
.uc-title { font-size: 15px; font-weight: 600; }
.uc-meta { font-size: 12px; color: var(--text-dim); margin-top: 2px; }
.uc-status { font-size: 11px; padding: 4px 10px; border-radius: 20px; background: var(--bg); color: var(--text-dim); flex-shrink: 0; white-space: nowrap; }
.uc-status.active { color: var(--gold-strong); background: var(--gold-wash); }
.uc-bar-track { height: 4px; border-radius: 2px; background: var(--bg); margin-top: 13px; overflow: hidden; }
.uc-bar-fill { height: 100%; background: var(--gold); border-radius: 2px; }

.text-nav { display: flex; justify-content: center; gap: 30px; margin-top: 36px; }
.text-nav button { background: none; border: none; color: var(--text-dim); font-size: 14px; cursor: pointer; padding: 8px; transition: color 0.15s ease; }
.text-nav button:hover { color: var(--accent); }

/* ---- Search ---- */
.search-wrap { position: relative; margin-bottom: 4px; }
.search-input { width: 100%; padding: 13px 16px; min-height: 46px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); color: var(--text); font-size: 16px; }
.search-input:focus { outline: none; border-color: var(--accent); }
.search-input::placeholder { color: var(--text-dim); }
.search-results { margin-top: 8px; display: flex; flex-direction: column; gap: 6px; }
.search-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; }
.search-row .sr-ar { font-family: 'Amiri', serif; font-size: 20px; direction: rtl; }
.search-row .sr-en { font-size: 12px; color: var(--text-dim); }

.translit-btn { background: none; border: none; color: var(--accent); font-size: 13px; text-decoration: underline; cursor: pointer; padding: 6px 0; }

/* ---- Flashcard ---- */
.flashcard {
  background: var(--surface-raised);
  border: 1px solid var(--line); border-radius: 20px;
  min-height: 330px; display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 20px; padding: 40px 26px; cursor: pointer; text-align: center;
  box-shadow: var(--shadow-md);
  animation: card-in 0.22s ease;
  position: relative;
}
.flashcard::after {
  content: ""; position: absolute; top: 0; left: 22px; right: 22px; height: 2px;
  background: var(--gold); border-radius: 0 0 2px 2px;
}
.flashcard::before {
  content: ""; position: absolute; bottom: 0; left: 22px; right: 22px; height: 2px;
  background: var(--line); border-radius: 2px 2px 0 0;
}
@keyframes card-in {
  from { opacity: 0; transform: translateY(6px) scale(0.99); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.card-ar { font-family: 'Amiri', serif; font-size: 52px; direction: rtl; line-height: 1.4; color: var(--text); }
.card-ar-sm { font-family: 'Amiri', serif; font-size: 22px; direction: rtl; }
.card-en { font-family: 'Lora', serif; font-size: 25px; font-weight: 600; }
.card-hint { font-size: 13px; color: var(--text-dim); margin-top: 4px; }
.tr { color: var(--text-dim); font-size: 15px; font-style: italic; }

.grade-row { display: flex; gap: 10px; margin-top: 22px; }
.grade-btn { flex: 1; padding: 15px 4px; min-height: 50px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); color: var(--text); font-size: 14px; cursor: pointer; transition: transform 0.12s ease; }
.grade-btn:active { transform: scale(0.97); }
.grade-btn.again { color: var(--warn); border-color: var(--warn); background: var(--warn-wash); }
.grade-btn.hard { color: var(--text-dim); }
.grade-btn.know { background: var(--accent); border-color: var(--accent); color: #fbf3ee; font-weight: 600; flex: 1.3; box-shadow: 0 6px 16px rgba(124,63,69,0.24); }

/* ---- Results ---- */
.results-card { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 30px; text-align: center; margin-bottom: 22px; box-shadow: var(--shadow-sm); }
.results-line { font-family: 'Lora', serif; font-size: 19px; margin-bottom: 8px; }
.results-line.dim { font-family: 'Work Sans', sans-serif; font-size: 14px; color: var(--text-dim); }

/* ---- Unit / word list ---- */
.unit-toolbar { display: flex; align-items: center; gap: 10px; margin-bottom: 24px; }
.chip-toggle { font-size: 12px; padding: 9px 15px; min-height: 36px; border-radius: 20px; border: 1px solid var(--line); background: var(--surface); color: var(--text-dim); cursor: pointer; }
.chip-toggle.on { border-color: var(--gold); color: var(--gold-strong); background: var(--gold-wash); }
.unit-toolbar .btn.primary { flex: 1; }

.word-list, .verb-list { display: flex; flex-direction: column; gap: 8px; }
.word-list-row, .verb-list-row {
  display: flex; justify-content: space-between; align-items: center; padding: 15px 16px; min-height: 52px;
  background: var(--surface); border: 1px solid var(--line); border-radius: 12px; cursor: pointer;
  transition: border-color 0.15s ease;
}
.word-list-row:nth-child(even), .verb-list-row:nth-child(even) { background: var(--surface-raised); }
.word-list-row:hover, .verb-list-row:hover { border-color: var(--accent); }
.wl-ar, .vl-ar { font-family: 'Amiri', serif; font-size: 21px; direction: rtl; }
.wl-en, .vl-en { font-size: 12px; color: var(--text-dim); margin-top: 2px; }
.vl-pres { font-size: 12px; color: var(--text-dim); margin-top: 2px; direction: rtl; font-family: 'Amiri', serif; }
.wl-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }

/* ---- Verb detail page ---- */
.verb-hero {
  text-align: center; background: var(--surface-raised); border: 1px solid var(--line);
  border-radius: 18px; padding: 32px 24px; margin-bottom: 24px; box-shadow: var(--shadow-md);
  position: relative;
}
.verb-hero::after {
  content: ""; position: absolute; top: 0; left: 24px; right: 24px; height: 2px;
  background: var(--gold); border-radius: 0 0 2px 2px;
}
.verb-hero::before {
  content: ""; position: absolute; bottom: 0; left: 24px; right: 24px; height: 2px;
  background: var(--line); border-radius: 2px 2px 0 0;
}
.verb-hero .vh-ar { font-family: 'Amiri', serif; font-size: 44px; direction: rtl; }
.verb-hero .vh-en { font-family: 'Lora', serif; font-size: 17px; font-style: italic; color: var(--text-dim); margin-top: 9px; }

.core-forms { display: flex; flex-direction: column; gap: 10px; margin-bottom: 28px; }
.core-form-row { display: flex; justify-content: space-between; align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 13px 16px; }
.core-form-row .cf-label { font-size: 12px; color: var(--text-dim); }
.core-form-row .cf-value { font-family: 'Amiri', serif; font-size: 19px; direction: rtl; }

.tense-tabs { display: flex; gap: 8px; margin-bottom: 20px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 5px; }
.tense-tab { flex: 1; padding: 11px 4px; border-radius: 8px; border: none; background: transparent; color: var(--text-dim); font-size: 14px; font-weight: 500; cursor: pointer; transition: background 0.15s ease, color 0.15s ease; }
.tense-tab.active { background: var(--accent); color: #fbf3ee; font-weight: 600; }

.conj-list { display: flex; flex-direction: column; gap: 0; margin-bottom: 22px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
.conj-row { display: flex; justify-content: space-between; align-items: center; padding: 15px 18px; border-bottom: 1px solid var(--line); }
.conj-row:nth-child(even) { background: var(--surface-raised); }
.conj-row:last-child { border-bottom: none; }
.conj-row .cr-pronoun { font-family: 'Amiri', serif; font-size: 17px; direction: rtl; color: var(--text-dim); width: 90px; flex-shrink: 0; }
.conj-row .cr-form { font-family: 'Amiri', serif; font-size: 20px; direction: rtl; flex: 1; text-align: right; color: var(--text); }

/* ---- Progress ---- */
.progress-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 22px; }
.progress-cell { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 22px; text-align: center; box-shadow: var(--shadow-sm); }
.pc-value { font-family: 'Lora', serif; font-size: 27px; font-weight: 600; color: var(--accent-strong); position: relative; display: inline-block; padding-bottom: 8px; }
.pc-value::after { content: ""; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 20px; height: 2px; background: var(--gold); border-radius: 1px; }
.pc-label { font-size: 12px; color: var(--text-dim); margin-top: 5px; }
.streak-line { text-align: center; color: var(--text-dim); font-size: 13px; }

/* ---- Settings ---- */
.setting-row { display: flex; justify-content: space-between; align-items: center; padding: 17px 4px; border-bottom: 1px solid var(--line); font-size: 15px; }
.toggle-switch { width: 46px; height: 27px; border-radius: 14px; border: 1px solid var(--line); background: var(--bg); position: relative; cursor: pointer; flex-shrink: 0; }
.toggle-switch.on { background: var(--accent); border-color: var(--accent); }
.toggle-knob { position: absolute; top: 2px; left: 2px; width: 21px; height: 21px; border-radius: 50%; background: #fdfaf5; box-shadow: 0 1px 3px rgba(44,37,33,0.25); transition: left 0.15s ease; }
.toggle-switch.on .toggle-knob { left: 21px; }
.export-area { width: 100%; min-height: 100px; border-radius: 10px; border: 1px solid var(--line); background: var(--surface); color: var(--text-dim); font-size: 11px; padding: 12px; font-family: monospace; }
.settings-message { font-size: 12px; color: var(--accent-strong); margin-top: 10px; }

/* ---- Modal ---- */
.modal-overlay { position: fixed; inset: 0; background: rgba(44, 37, 33, 0.42); display: flex; align-items: center; justify-content: center; z-index: 50; padding: 20px; }
.modal-card { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 26px; max-width: 380px; width: 100%; max-height: 86vh; overflow-y: auto; box-shadow: var(--shadow-md); position: relative; }
.modal-card::before {
  content: ""; position: absolute; top: 0; left: 26px; right: 26px; height: 2px;
  background: var(--gold); border-radius: 0 0 2px 2px;
}
.modal-card-wide { max-width: 400px; }
.modal-title { font-family: 'Lora', serif; font-size: 19px; font-weight: 600; margin-bottom: 11px; }
.modal-body { font-size: 14px; color: var(--text-dim); margin-bottom: 22px; line-height: 1.6; }
.modal-actions { display: flex; gap: 10px; }

.onboard-row { display: flex; justify-content: space-between; align-items: center; padding: 15px 4px; min-height: 44px; border-bottom: 1px solid var(--line); cursor: pointer; font-size: 14px; }
.onboard-row:last-of-type { border-bottom: none; }
.onboard-mark { color: var(--text-dim); }
.onboard-row.checked .onboard-mark { color: var(--accent); }

.empty-state { text-align: center; color: var(--text-dim); padding: 42px 16px; font-size: 14px; }

@media (max-width: 360px) {
  .flashcard { min-height: 290px; padding: 30px 18px; }
  .card-ar { font-size: 42px; }
  .verb-hero .vh-ar { font-size: 36px; }
  .conj-row .cr-pronoun { width: 74px; }
}

</style>
</head>
<body>
<div id="root"></div>
<script type="text/babel" data-presets="react">
const { useState, useEffect, useMemo, useCallback, useRef } = React;


// ============================================================================
// TEXTBOOK DATA — At-Takallum Elementary A1-A2 Student's Book.
// Authoritative curriculum. Nothing in the data section below has been
// altered, reordered, or added to — only the learning system around it
// (helpers, conjugation engine, and components) is new.
// ============================================================================

// ---- from data/vocabulary.js ----
// Textbook vocabulary — At-Takallum Elementary A1-A2 Student's Book.
// This is the authoritative curriculum. Do not add, remove, reorder, or
// reword entries here; the learning system in src/utils and src/components
// is what may change, never this file's content.

const WORDS = [
  // Unit 1 — Nice to Meet You (jobs, introductions)
  { id: 1, ar: "وَظِيفَة", tr: "waẓīfa", en: "job / profession", cat: "u1" },
  { id: 2, ar: "مُتَرْجِم", tr: "mutarjim", en: "translator", cat: "u1" },
  { id: 3, ar: "عَامِل", tr: "ʿāmil", en: "worker", cat: "u1" },
  { id: 4, ar: "طَالِب", tr: "ṭālib", en: "student", cat: "u1" },
  { id: 5, ar: "مُعَلِّم", tr: "muʿallim", en: "teacher", cat: "u1" },
  { id: 6, ar: "صَدِيقَة", tr: "ṣadīqa", en: "friend (f)", cat: "u1" },
  { id: 7, ar: "نَجَّار", tr: "najjār", en: "carpenter", cat: "u1" },
  { id: 8, ar: "مُتَقَاعِد", tr: "mutaqāʿid", en: "retired", cat: "u1" },
  { id: 9, ar: "صَحَفِي", tr: "ṣaḥafī", en: "journalist", cat: "u1" },
  { id: 10, ar: "هَاتِف مَحْمُول", tr: "hātif maḥmūl", en: "mobile phone", cat: "u1" },
  { id: 11, ar: "مُحَاسِب", tr: "muḥāsib", en: "accountant", cat: "u1" },
  { id: 12, ar: "بَرِيد إِلِكْتِرُونِي", tr: "barīd iliktrūnī", en: "email", cat: "u1" },
  { id: 13, ar: "هَاتِف أَرْضِي", tr: "hātif arḍī", en: "landline", cat: "u1" },
  { id: 14, ar: "عُنْوَان", tr: "ʿunwān", en: "address", cat: "u1" },
  { id: 15, ar: "عَاطِل", tr: "ʿāṭil", en: "unemployed", cat: "u1" },

  // Unit 2 — My Family
  { id: 16, ar: "جَد", tr: "jadd", en: "grandfather", cat: "u2" },
  { id: 17, ar: "جَدَّة", tr: "jadda", en: "grandmother", cat: "u2" },
  { id: 18, ar: "وَالِد", tr: "wālid", en: "father", cat: "u2" },
  { id: 19, ar: "وَالِدَة", tr: "wālida", en: "mother", cat: "u2" },
  { id: 20, ar: "أُخْت", tr: "ukht", en: "sister", cat: "u2" },
  { id: 21, ar: "أَخ", tr: "akh", en: "brother", cat: "u2" },
  { id: 22, ar: "حَفِيد", tr: "ḥafīd", en: "grandchild", cat: "u2" },
